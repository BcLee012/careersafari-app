# ============================================================
# CareerSafari 配置模板
# 用法：cp .env.example .env   然后填入你自己的值
# .env 已被 .gitignore 排除，不会进入 git
# ============================================================

# ---------- LLM：Stepfun ----------
# ⚠️ Stepfun 有两个端点，key 不通用，用错会报错：
#   https://api.stepfun.com/v1            平台按量计费（需账户有余额）
#   https://api.stepfun.com/step_plan/v1  coding plan 订阅（用订阅额度）
# 不确定自己持哪一种就两个都试；401=key 不属于该端点，402=余额/额度不足。
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
STEPFUN_MODEL=step-3.7-flash
# 可用模型（GET {BASE_URL}/models 可列出）：step-3.7-flash / step-3.5-flash /
#   step-3.5-flash-2603 / step-5-preview / step-router-v1

# ---------- LLM 行为 ----------
# 推理模型会把 token 花在 reasoning 上（实测一条 500 字 JD 产生 10–14k reasoning token）。
# 这只是默认值；代码里显式传 max_tokens 的任务（如 JD 拆解传 16384）以参数为准。
LLM_MAX_TOKENS=8192
# 推理强度 low / medium / high，留空用模型默认。JD 拆解需要仔细推理，建议留空；
# 建议润色层在代码里固定用 low（只是改写文字）。
LLM_REASONING_EFFORT=

# ---------- 管理令牌 ----------
# 写操作（JD 确认入库）要求 X-Admin-Token；未配置时写操作 fail-closed 直接关闭。
# 留空即可 —— 首次启动服务端会自动生成并写回 .env。
ADMIN_TOKEN=

# ---------- URL 采集 ----------
# 本地开发逃生开关：某些网络环境（透明代理）会把全部域名解析到 198.18.x.x
# （RFC 2544 测试段），导致 SSRF 公网地址校验全数误杀。设为 1 可跳过该项校验。
# ⚠️ 仅限本地开发。公网部署必须关闭，否则 SSRF 防护失效。
FETCH_ALLOW_NON_PUBLIC=0
# 受控采集白名单模式：off（不限制域名）/ warn（不拦截，仅提示，默认）/ enforce（白名单外一律拒绝）
FETCH_ALLOWLIST_MODE=warn
# 逗号分隔，追加白名单域名后缀或子域名标签（如 .edu.cn 或 hr.）
FETCH_ALLOWED_SUFFIXES=
